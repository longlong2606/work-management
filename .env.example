# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DOCKER - WORK MANAGEMENT
# Bạn có thể đổi cổng hoặc mật khẩu tại đây mà không cần sửa code.
# ============================================================

# Cổng truy cập Web Frontend trên máy host (ví dụ: 3000, 3005, 8080...)
WEB_PORT=3000

# Cổng truy cập Backend API .NET trên máy host (ví dụ: 8001, 8000...)
API_PORT=8001

# Cổng kết nối Database PostgreSQL trên máy host
DB_PORT=5432

# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_DB=work_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_2026
